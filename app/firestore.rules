rules_version = '2';

// Firestore セキュリティルール
//
// 設計方針 (詳細は docs/requirements/firestore-rules.md):
//   - 認証必須を全体の前提とする
//   - users/passions/chats は本人 (request.auth.uid) ベースで判定
//   - eggs/characters は currentOwnerUid / ownerUid フィールドで判定
//     (characters.ownerUid は schema-refinement で追加した非正規化フィールド)
//   - eggs/characters/exchanges の create は Cloud Function (admin SDK) のみ
//     → クライアントからは create 不可。Admin SDK はルールをバイパスするので Functions では書ける
//   - ownership transfer (eggs.currentOwnerUid 変更) もクライアント不可、Cloud Function 専用
//   - chats/{chatId}/messages サブコレクションは親 chat の userUid を get() でチェック

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // update 時にあるフィールドが変更されていないことを確認
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function isValidVisibility(value) {
      return value in ['public', 'friends', 'private'];
    }

    function isValidPassionBase() {
      return request.resource.data.keys().hasOnly([
        'ownerUid',
        'title',
        'description',
        'tags',
        'embedding',
        'createdAt',
        'visibility',
        'overview',
        'makingStatus',
        'subjectAttractions',
        'chatHistory',
      ]) &&
      request.resource.data.ownerUid is string &&
      request.resource.data.title is string &&
      request.resource.data.description is string &&
      request.resource.data.tags is list &&
      request.resource.data.embedding is list &&
      request.resource.data.createdAt is timestamp &&
      isValidVisibility(request.resource.data.visibility) &&
      (!('overview' in request.resource.data) || request.resource.data.overview is string) &&
      (!('makingStatus' in request.resource.data) || request.resource.data.makingStatus in ['draft', 'interviewing', 'finalized']) &&
      (!('subjectAttractions' in request.resource.data) || request.resource.data.subjectAttractions is list) &&
      request.resource.data.chatHistory is list &&
      request.resource.data.chatHistory.size() <= 200;
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    // ---------- passions/{passionId} ----------
    match /passions/{passionId} {
      allow read: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && isValidPassionBase();
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && isUnchanged('ownerUid')
                    && isUnchanged('createdAt')
                    && isValidPassionBase();
      allow delete: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;

      match /makingMessages/{messageId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/passions/$(passionId)).data.ownerUid == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/passions/$(passionId)).data.ownerUid == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---------- eggs/{eggId} ----------
    // 作成は本人 (sourceUser == currentOwner == auth.uid) のみ
    //   ハッカソン MVP では Cloud Function 経由の egg 生成を待たず、
    //   クライアントから local egg を Firestore に upsert する経路を許可する
    // 所有者変更 (currentOwnerUid) は Cloud Function (exchange) のみ
    match /eggs/{eggId} {
      allow read: if isSignedIn()
                  && resource.data.currentOwnerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.sourceUserUid == request.auth.uid
                    && request.resource.data.currentOwnerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.currentOwnerUid == request.auth.uid
                    && isUnchanged('currentOwnerUid')
                    && isUnchanged('sourceUserUid');
      allow delete: if false;
    }

    // ---------- characters/{characterId} ----------
    // characterId == eggId (decisive ID), ownerUid フィールドで判定
    match /characters/{characterId} {
      allow read: if isSignedIn()
                  && resource.data.ownerUid == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && isUnchanged('ownerUid')
                    && isUnchanged('eggId');
      allow delete: if false;
    }

    // ---------- exchanges/{exchangeId} ----------
    // 作成・更新ともに Cloud Function 専用、read は当事者のみ
    match /exchanges/{exchangeId} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ---------- chats/{chatId} ----------
    // chatId == `${characterId}_${userUid}` (decisive ID)
    // userUid フィールドが本人と一致するかで判定
    match /chats/{chatId} {
      allow read: if isSignedIn()
                  && resource.data.userUid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userUid == request.auth.uid
                    && isUnchanged('userUid')
                    && isUnchanged('characterId');
      allow delete: if false;

      // ---------- chats/{chatId}/messages/{messageId} ----------
      // 親 chat ドキュメントの userUid を取得して所有者チェック
      // get() は 1 read 分の課金あり (ハッカソン規模では無視可能)
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isSignedIn() && parentChat().userUid == request.auth.uid;
        allow create: if isSignedIn() && parentChat().userUid == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
